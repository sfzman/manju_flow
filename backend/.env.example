APP_ENV=local

# 服务器配置
SERVER_PORT=8080
GIN_MODE=debug

# 数据库配置
# 支持 sqlite 和 mysql
DB_DRIVER=sqlite
DB_NAME=manju_flow

# MySQL 配置（当 DB_DRIVER=mysql 时使用）
# DB_DRIVER=mysql
# DB_HOST=localhost
# DB_PORT=3306
# DB_USER=root
# DB_PASSWORD=your_password
# DB_NAME=manju_flow

# 阿里云 OSS 配置（可选，用于文件上传）
# OSS_ENDPOINT=oss-cn-hangzhou.aliyuncs.com
# OSS_ACCESS_KEY_ID=your_access_key_id
# OSS_ACCESS_KEY_SECRET=your_access_key_secret
# OSS_BUCKET_NAME=your_bucket_name

# 豆包音频生成服务配置（用于音频后期生成）
TTS_API_URL=https://openspeech.bytedance.com/api/v3/tts/create
TTS_API_KEY=your_speech_api_key
TTS_MODEL=seed-audio-1.0
TTS_AUDIO_FORMAT=mp3

# 火山引擎 Ark 视频生成服务配置（用于动画制作中的 Seedance 视频工作台）
ARK_API_BASE_URL=https://ark.cn-beijing.volces.com/api
# ARK_API_KEY=ark-xxx

# 阿里云百炼万相视频生成配置（可选，用于动画制作中的 Wan 3.0 模型）
# WAN_API_BASE_URL=https://<workspace-id>.<region>.maas.aliyuncs.com
# WAN_API_KEY=sk-xxx
# WAN_WORKSPACE_ID=your_workspace_id
WAN_REGION=cn-beijing

# 火山引擎 Ark Agent Plan 配置（用于 LLM / 图片理解，例如角色核心特征生成）
ARK_AGENT_PLAN_API_BASE_URL=https://ark.cn-beijing.volces.com/api/plan
# ARK_AGENT_PLAN_API_KEY=ark-xxx
# Ark Agent Plan 支持的 LLM 模型 ID 列表，支持逗号分隔或 JSON 数组；第一个为默认模型
ARK_AGENT_PLAN_SUPPORTED_LLM_MODELS=doubao-seed-2-1-pro-260628

# 章节 txt 导入 AI 分析超时（Go duration 格式如 5m，纯数字按秒）；脚本越大越可能需要调大
# CHAPTER_IMPORT_AI_TIMEOUT=5m

# CORS 跨域配置
# 生产环境应配置具体的前端域名，多个用逗号分隔
# CORS_ORIGINS=https://your-app.vercel.app,https://custom-domain.com
CORS_ORIGINS=*

# 注册白名单配置
# 只有在白名单中的用户名（邮箱）才能注册，多个用逗号分隔
# REGISTER_WHITELIST=user1@example.com,user2@example.com

# 登录会话有效期，Go duration 格式（如 720h）或纯小时数（如 168）
# 一个账号可同时保持多个会话（多浏览器/多设备互不挤下线），过期会话由后台定时清理
# SESSION_TTL=720h
